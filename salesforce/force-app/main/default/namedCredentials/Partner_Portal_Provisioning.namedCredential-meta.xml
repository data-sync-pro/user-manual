<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Legacy (Password-protocol) Named Credential, on purpose: no External Credential, no
         principal, no permission set — any Apex in the org can use it, and the secret is one
         plain Password field on this record's Setup page.
         The password below is a PLACEHOLDER; the deploy requires the field to exist. After EVERY
         deploy of this file an admin must overwrite it in Setup with the real SF_PUSH_SECRET
         (Setup -> Named Credentials -> Partner Portal Provisioning -> Edit -> Password), because
         deploying resets the org value back to this placeholder and every call 401s until fixed. -->
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>true</allowMergeFieldsInHeader>
    <endpoint>https://us-central1-partnerportal-b1d25.cloudfunctions.net</endpoint>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <label>Partner Portal Provisioning</label>
    <password>REPLACE_IN_SETUP_WITH_SF_PUSH_SECRET</password>
    <principalType>NamedUser</principalType>
    <protocol>Password</protocol>
    <username>portal</username>
</NamedCredential>
