<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Partner Portal Admin</label>
    <description>Read+edit FLS on every Partner Portal custom field, for the humans who administer it. Metadata API deploys grant NO profile FLS, so without this even a System Administrator cannot see or set PartnerType__c / Primary_Contact__c.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <objectPermissions>
        <object>DealRegistration__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>

    <!-- Account fields that mark a partner. Editable: this is how an admin marks an
         Account as a partner, which is what fires the provisioning push. -->
    <fieldPermissions>
        <field>Account.PartnerType__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Account.Primary_Contact__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>

    <!-- Every DealRegistration field, so deals are viewable/editable in Salesforce. -->
    <fieldPermissions>
        <field>DealRegistration__c.PartnerPortalDealID__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.Amount__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.CustomerCompanyName__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.CustomerWebsite__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.CustomerContactFirstName__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.CustomerContactLastName__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.CustomerContactTitle__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.CustomerContactEmail__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.Stage__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.CustomerCountry__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.industry__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.CustomerCompanySize__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.CustomerOrgType__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.Track__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.RequestedLicenseInfo__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>DealRegistration__c.PartnerAccount__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
</PermissionSet>
