{
  "name": "partner-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Data Sync Pro Partner Portal — Firebase (Hosting + Auth + Firestore)",
  "type": "commonjs",
  "scripts": {
    "emulators": "firebase emulators:start --import=./.emulator-data --export-on-exit=./.emulator-data",
    "emulators:fresh": "firebase emulators:start",
    "seed": "node scripts/seed.js",
    "dev": "firebase emulators:start --import=./.emulator-data --export-on-exit=./.emulator-data",
    "build": "npm --prefix web run build",
    "start:web": "npm --prefix web start"
  },
  "devDependencies": {
    "firebase-admin": "^13.0.2"
  }
}
